#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

printf '%s\n' 'Pre-push: validating GitHub Actions references...'
uv run --locked python scripts/check_action_refs.py

printf '%s\n' 'Pre-push: running tests...'
uv run --locked python -m unittest discover -s tests -v

build_directory=$(mktemp -d /tmp/mdstyledocx-pre-push.XXXXXX)
cleanup() {
    rm -rf -- "$build_directory"
}
trap cleanup EXIT HUP INT TERM

printf '%s\n' 'Pre-push: building release distributions...'
uv build --out-dir "$build_directory"

printf '%s\n' 'Pre-push checks passed.'
